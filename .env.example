PORT=3000
HOST=0.0.0.0
BASE_URL=
SESSION_SECRET=replace-with-a-long-random-secret
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Optional: coturn REST API shared secret (static-auth-secret).
# When set, the app issues short-lived TURN credentials instead of exposing
# the static TURN_USERNAME/TURN_PASSWORD pair to browsers.
TURN_SHARED_SECRET=

# Optional deployment settings
NODE_ENV=development
SESSION_TTL_SECONDS=1800
TRUST_PROXY=0